---
import { Image } from "astro:assets";
import LogoSallute from "../../assets/logos/logoSallute.svg";
import Relogio from "../../assets/icons/icon_relogio.svg";

const navLinks = [
  { label: "Início", href: "/" },
  { label: "Quem Somos", href: "/QuemSomos" },
  { label: "Serviços", href: "/#Servicos" },
  { label: "Corpo Clínico", href: "/CorpoClinico" },
];

const horario = {
  icon: Relogio,
  titulo: "Horário de Funcionamento",
  texto: "Segunda a Sábado, das 07:30h às 18h"
};
const agendarHref = "https://wa.me/5582999689119";
---

<header class="bg-[#3ABDAD] text-white py-1 sticky top-0 z-50" id="main-header">
  <nav class="flex items-center justify-between max-w-7xl mx-auto">
    <div class="flex-shrink-0 mr-4 md:mr-6 lg:mr-8 ml-2 md:ml-0">
      <a href="/"><Image src={LogoSallute} alt="Sallute Logo" width={200} height={100} class="object-contain w-44 sm:w-48 md:w-52 lg:w-56"/></a>
    </div>
    <button id="menu-toggle" class="md:hidden flex flex-col justify-center items-center w-10 h-10 space-y-1.5 mr-4" aria-label="Menu" aria-expanded="false">
      {[...Array(3)].map(() => <span class="w-6 h-0.5 bg-white transition-all duration-200"></span>)}
    </button>
    <ul class="hidden md:flex space-x-4 md:space-x-6 lg:space-x-8 font-medium">
      {navLinks.map(({ label, href }) => (
        <li><a href={href} class="hover:text-teal-900 transition-colors">{label}</a></li>
      ))}
    </ul>
    <div class="hidden lg:flex items-center space-x-3">
      <Image src={horario.icon} alt="Ícone de Relógio" width={24} height={24} />
      <div class="flex flex-col text-sm">
        <span class="font-semibold">{horario.titulo}</span>
        <span>{horario.texto}</span>
      </div>
    </div>
    <a href={agendarHref} class="hidden md:block ml-4">
      <button class="cursor-pointer border border-white hover:bg-teal-600 transition-colors text-white font-medium py-1 px-5 rounded-3xl">Agendar Consulta</button>
    </a>
  </nav>
  <div id="mobile-menu" class="md:hidden bg-[#3ABDAD] shadow-lg absolute left-0 right-0 top-full overflow-hidden max-h-0 transition-all duration-300 ease-in-out z-40">
    <div class="px-6 py-4">
      <ul class="flex flex-col space-y-3">
        {navLinks.map(({ label, href }) => (
          <li><a href={href} class="block py-2 hover:text-teal-900 transition-colors">{label}</a></li>
        ))}
      </ul>
      <div class="mt-4 pt-3 border-t border-teal-500 flex items-center space-x-3">
        <Image src={horario.icon} alt="Ícone de Relógio" width={20} height={20} loading="eager" />
        <div class="flex flex-col text-sm">
          <span class="font-semibold">{horario.titulo}</span>
          <span>{horario.texto}</span>
        </div>
      </div>
      <div class="mt-4 pt-3 block">
        <a href={agendarHref}><button class="w-full border border-white hover:bg-teal-600 transition-colors text-white font-medium py-2 px-4 rounded-3xl">Agendar Consulta</button></a>
      </div>
    </div>
  </div>
</header>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const closeMenu = () => {
    if (mobileMenu) mobileMenu.style.maxHeight = "0px";
    if (menuToggle) menuToggle.setAttribute("aria-expanded", "false");
    if (menuToggle) {
      const spans = menuToggle.querySelectorAll("span");
      spans[0].classList.remove("rotate-45", "translate-y-2");
      spans[1].classList.remove("opacity-0");
      spans[2].classList.remove("-rotate-45", "-translate-y-2");
    }
    document.removeEventListener("click", handleOutsideClick);
  };
  const handleOutsideClick = (event) => {
    if (
      (!mobileMenu || !mobileMenu.contains(event.target)) &&
      (!menuToggle || !menuToggle.contains(event.target))
    ) closeMenu();
  };
  if (menuToggle && mobileMenu) {
    menuToggle.addEventListener("click", (event) => {
      event.stopPropagation();
      const isExpanded = menuToggle.getAttribute("aria-expanded") === "true";
      if (isExpanded) closeMenu();
      else {
        menuToggle.setAttribute("aria-expanded", "true");
        mobileMenu.style.maxHeight = mobileMenu.scrollHeight + "px";
        const spans = menuToggle.querySelectorAll("span");
        spans[0].classList.add("rotate-45", "translate-y-2");
        spans[1].classList.add("opacity-0");
        spans[2].classList.add("-rotate-45", "-translate-y-2");
        setTimeout(() => document.addEventListener("click", handleOutsideClick), 10);
      }
    });
    window.addEventListener("resize", () => { if (window.innerWidth >= 768) closeMenu(); });
    mobileMenu.querySelectorAll("a").forEach(link => link.addEventListener("click", closeMenu));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && menuToggle.getAttribute("aria-expanded") === "true") closeMenu();
    });
  }
});
</script>
