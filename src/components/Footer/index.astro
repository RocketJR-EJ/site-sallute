---
import { Image } from "astro:assets";
import Iconrocket from "../../assets/logo-rocket.svg";
import Frase2 from "../../assets/frase2.svg";
import logoAtual from "../../assets/logoAtual.svg";
import Iconfacebook from "../../assets/socialbuttons/facebook.svg";
import Iconwhatsapp from "../../assets/socialbuttons/whatsapp.svg";
import Iconinstagram from "../../assets/socialbuttons/instagram.svg";
import Icontelefone from "../../assets/socialbuttons/telefone.svg";
import Iconemail from "../../assets/socialbuttons/email.svg";

const socialLinks = [
  { href: "https://wa.me/5582999689119", icon: Iconwhatsapp, alt: "WhatsApp" },
  { href: "https://www.instagram.com/sallute.clinica/", icon: Iconinstagram, alt: "Instagram" },
  { href: "https://www.facebook.com/sallute.penedo/", icon: Iconfacebook, alt: "Facebook" },
  { href: "tel:+5582999689119", icon: Icontelefone, alt: "Telefone" },
  { href: "mailto:salluteclinica@outlook.com", icon: Iconemail, alt: "Email" },
];

const menus = [
  {
    title: "Institucional",
    items: [
      { label: "Sobre Nós", href: "/QuemSomos#quemsomos" },
      { label: "Nossos Valores", href: "/QuemSomos#valores" },
      { label: "Política de Privacidade", href: "/PoliticaPrivacidade" },
      { label: "Termos de Uso", href: "/TermosUso" },
    ],
  },
  {
    title: "Empresa",
    items: [
      { label: "Quem Somos", href: "/QuemSomos#quemsomos" },
      { label: "Nossa Estrutura", href: "/QuemSomos#estrutura" },
      { label: "Trabalhe Conosco", href: "https://wa.me/5582999689119" },
      { label: "SAC - 82 9 9993-0051" },
    ],
  },
  {
    title: "Serviços",
    items: [
      { label: "Fisioterapia", href: "/Servicos#fisioterapia" },
      { label: "Ultrassonografia", href: "/Servicos#ultrassonografia" },
      { label: "Depilação a Laser", href: "/Servicos#depilacao" },
      { label: "Exames em Geral", href: "/Servicos#exames" },
    ],
  },
];
---

<style>
  @import url("https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap");
</style>

<footer class="bg-gradient-to-br from-teal-600 to-teal-700 text-white py-6">
  <article class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col md:flex-row justify-between gap-4">
      <div class="flex flex-col md:w-1/3">
        <div class="text-center md:text-left mb-4 md:mb-1">
          <Image src={logoAtual} alt="Logo Sallute" class="mx-auto md:mx-0" width={200} height={100} />
          <Image src={Frase2} alt="Frase Sallute" class="mx-auto md:mx-0" width={250} height={67} />
          <p class="mt-2 text-base">Entre em contato agora e agende sua consulta!</p>
        </div>
        <div class="flex space-x-3 mt-2 justify-center md:justify-start">
          {socialLinks.map(({ href, icon, alt }) => (
            <a href={href} class="bg-teal-500 hover:bg-teal-400 p-2 rounded-full" target="_blank" rel="noopener noreferrer">
              <img src={icon.src} alt={alt} class="w-5 h-5" />
            </a>
          ))}
        </div>
      </div>
      <div class="flex flex-col md:flex-row gap-4 md:gap-8 mt-4 md:mt-0 md:w-2/3 md:justify-end">
        {menus.map(({ title, items }) => (
          <div class="text-left">
            <h4 class="text-[20px] font-semibold mb-1 border-b border-[#FAFAFA] pb-1 w-36">{title}</h4>
            <ul class="space-y-0.5 text-base text-[#FAFAFA]">
              {items.map(({ label, href }) =>
                href
                  ? <li><a href={href} class="hover:underline">{label}</a></li>
                  : <li>{label}</li>
              )}
            </ul>
          </div>
        ))}
      </div>
    </div>
    <div class="mt-4 text-white text-center md:text-right">
      <p class="text-sm sm:text-base leading-relaxed">
        📍 Endereço: Rua Eng. Joaquim Gonçalves, nº 200, Santa Luzia,<br />
        Penedo/AL - em frente à Codevasf - CNPJ 24.080.965/0001-08.
      </p>
    </div>
    <div class="border-t border-[#FAFAFA] my-3"></div>
    <div class="flex flex-col md:flex-row justify-between gap-2 text-center md:text-left">
      <div class="flex flex-col md:flex-row items-center justify-center md:justify-start space-y-1 md:space-y-0 md:space-x-2">
        <span class="text-[17px]">Desenvolvido por:</span>
        <a href="https://rocketjr.com.br" target="_blank" rel="noopener noreferrer" class="hover:opacity-80 transition-opacity">
          <img src={Iconrocket.src} alt="Rocket JR" class="h-[25px] md:h-[35px] w-auto" />
        </a>
      </div>
      <p class="mt-1 md:mt-0 text-[17px]">
        2025 © <strong>Sallute Clínica Médica Penedo</strong> - Todos os direitos reservados.
      </p>
    </div>
  </article>
</footer>
